# ---------------------------------------------------------------------------
# Utilmo AI Assistant — environment variables (set them in Netlify: Site configuration → Environment variables).
# Never commit real values.
# ---------------------------------------------------------------------------

# --- AI provider -----------------------------------------------------------
# On Netlify, AI Gateway injects ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL automatically (no key needed).
# Set AI_API_KEY only to use your own provider account instead of the gateway.
AI_PROVIDER=anthropic            # anthropic | openai
AI_API_KEY=                      # optional (own key); leave empty to use Netlify AI Gateway
AI_BASE_URL=                     # optional custom base URL
AI_MODEL=                        # optional override of the response model (default from admin: claude-opus-5-5)
AI_ANALYSIS_MODEL=               # optional override of the analysis model (default: claude-haiku-5-5)

# --- Optional semantic retrieval (pgvector hybrid search) ----------------------
EMBEDDING_PROVIDER=              # openai | (empty = full-text retrieval only)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# --- Database --------------------------------------------------------------
# Default: Netlify Database (provisioned automatically from @netlify/database; NETLIFY_DB_URL injected).
# Set DATABASE_URL to use another Postgres instead (e.g. Supabase / Neon connection string).
DATABASE_URL=

# --- Secrets (REQUIRED in production, min. 16 random characters each) --------
SESSION_SECRET=                  # signs visitor session tokens + hashes IPs
ADMIN_AUTH_SECRET=               # signs admin sessions + internal crawl calls
ENCRYPTION_KEY=                  # encrypts integration secrets at rest (AES-256-GCM)
ADMIN_SETUP_TOKEN=               # one-time token to create the first owner account at /admin

# --- Widget / origins --------------------------------------------------------
APP_BASE_URL=                    # e.g. https://utilmo-ai-assistant.netlify.app (optional; auto-detected)
ALLOWED_WIDGET_ORIGINS=          # extra allowed origins, comma-separated (per-assistant domains are managed in the admin)
ALLOW_LOCALHOST_ORIGINS=false

# --- Integrations ------------------------------------------------------------
# Webhook URLs and secrets are configured per integration in the admin (stored encrypted), not here.
# WEBHOOK_URL / WEBHOOK_SECRET are intentionally not used: multiple destinations per tenant are supported.
